LIVEKIT_URL=http://localhost:7880
LIVEKIT_WS_URL=wss://localhost:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-postgres-password
PG_DATABASE=cooperative
JWT_SECRET=generate-a-long-random-string
TOKEN_TTL_SECONDS=86400
IDLE_TIMEOUT_MINUTES=60
# Lesson limits and cleanup (defaults shown)
MAX_LESSONS_PER_TEACHER=1000
MAX_OPEN_LESSONS_PER_TEACHER=5
TEACHER_ABSENT_MINUTES=15
# Encrypted teacher journal, size limit in bytes (default shown)
MAX_JOURNAL_BYTES=1048576
# Mail: our own mail server, the platform's sending box (password reset codes, «Написать нам»)
#SMTP_HOST=mail.example.org
#SMTP_PORT=587
#SMTP_USER=noreply@example.org
#SMTP_PASS=
# «Написать нам» (POST /feedback): errors, ideas, everything else (FEEDBACK_TO is also the fallback)
#FEEDBACK_TO=feedback@example.org
#FEEDBACK_TO_BUG=bugs@example.org
#FEEDBACK_TO_IDEA=ideas@example.org
