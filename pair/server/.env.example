# Copy to .env next to start.mjs. .env is not committed.

# Signaling (WebSocket) — behind nginx at /ws
PORT=13119
HOST=127.0.0.1

# Built-in STUN server on UDP; open this port in the firewall. 0 = off.
STUN_PORT=3478

# Per-IP limits for signaling connections (defaults: 100 open, 120 new per minute).
# A school behind one IP needs headroom; raise for load tests.
#SOCKETS_PER_IP=100
#CONNECTS_PER_IP_PER_MINUTE=120

# STUN/TURN list handed to browsers when they join, as RTCIceServer JSON on one line.
# Your own STUN (this host, STUN_PORT). Foreign public STUN servers may be blocked by providers.
ICE_SERVERS=[{"urls":["stun:stun.example.org"]}]
