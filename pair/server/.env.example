# Copy to .env next to start.mjs. .env is not committed.

# Signaling (WebSocket) — behind nginx at /ws
PORT=13119
HOST=127.0.0.1

# Built-in STUN server on UDP; open this port in the firewall. 0 = off.
STUN_PORT=3478

# STUN/TURN list handed to browsers when they join, as RTCIceServer JSON on one line.
# Usually your own STUN first (this host, STUN_PORT), then a public one as a fallback.
ICE_SERVERS=[{"urls":["stun:pair.example.org:3478","stun:stun.example.net:3478"]}]
